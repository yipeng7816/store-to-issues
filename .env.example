# Neon / Postgres (required after prisma provider = postgresql)
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx.aws.neon.tech/neondb?sslmode=require"
SESSION_SECRET="replace-with-long-random-string-at-least-32-chars"
ENCRYPTION_KEY="replace-with-another-long-random-string"
USE_MOCK_REVIEWS="true"

GITHUB_TOKEN=""
GITHUB_REPO="owner/repo"

ASC_ISSUER_ID=""
ASC_KEY_ID=""
ASC_PRIVATE_KEY=""
ASC_APP_ID=""

GOOGLE_PLAY_PACKAGE_NAME="com.example.app"
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=""
# GOOGLE_APPLICATION_CREDENTIALS="/absolute/path/service-account.json"

CRON_SECRET=""

# Create GitHub issues for reviews at or below this star rating (1-5).
MIN_RATING="3"

# Billing (optional for local trial)
TRIAL_DAYS="14"
APP_URL="http://localhost:3000"
SUPPORT_EMAIL="ymyjobp@163.com"
# Optional: https://resend.com — needed to actually send verify/reset emails
RESEND_API_KEY=""
EMAIL_FROM="StoreToIssues <onboarding@resend.dev>"

# Creem MoR (recommended for China founders) — https://www.creem.io /
# Dashboard: create $12/mo product, copy API key + product id, add webhook
CREEM_API_KEY=""
CREEM_PRODUCT_ID=""
CREEM_WEBHOOK_SECRET=""
# true → https://test-api.creem.io (also auto if key starts with creem_test_)
CREEM_TEST_MODE="true"

# Stripe (optional legacy fallback; skip if using Creem)
STRIPE_SECRET_KEY=""
STRIPE_PRICE_ID=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
